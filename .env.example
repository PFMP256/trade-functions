# Copy into an environment-specific deployment configuration. Do not overwrite an existing .env.
# Local fixture commands do NOT load .env or any credentials.
TRADING_MODE=dry_run
BYBIT_ENVIRONMENT=testnet
ALLOW_NEW_ENTRIES=true
# Required by the default public strategy. BLS and Kraken do not need API keys.
PUBLIC_DATA_ENABLED=true
# Optional operator contact (email or HTTPS URL) appended to the declared BLS robot User-Agent.
# BLS may block robots without owner contact information. Not a secret; never inferred.
# BLS_CONTACT=operator@example.org
DEDICATED_ACCOUNT_CONFIRMED=false
BYBIT_ACCOUNT_ID=replace-with-dedicated-bybit-uid
APP_REGION=southamerica-east1
SCENARIO_CONFIG_PATH=scenarios/btc-nfp-public-2026-10-02.demo.json
SOURCE_REGISTRY_PATH=config/source-registry.json
# SOURCE_REGISTRY_PATH and manual ingestion are used only by the original NFP/ETF strategy.
# Optional evidence from supervised testnet verification; no longer a live entry prerequisite.
# BYBIT_COMPATIBILITY_ATTESTATION_PATH=config/bybit-testnet-attestation.json
# Optional secret provisioning while remaining dry_run: none (default), mainnet, testnet.
# Operating live/testnet modes always bind their own pair. This does not enable trading.
BYBIT_CREDENTIAL_BINDING=none
RUNTIME_SERVICE_ACCOUNT=btc-runtime@YOUR_PROJECT.iam.gserviceaccount.com
SCHEDULER_SERVICE_ACCOUNT=btc-scheduler@YOUR_PROJECT.iam.gserviceaccount.com
INGESTOR_SERVICE_ACCOUNTS=btc-ingestor@YOUR_PROJECT.iam.gserviceaccount.com
RUN_FUNCTION_URL=https://REGION-PROJECT.cloudfunctions.net/runBtcNfpEtfBybitV1
INGEST_FUNCTION_URL=https://REGION-PROJECT.cloudfunctions.net/ingestBtcNfpEtfDataV1
RECONCILE_QUEUE=btc-reconcile
# BYBIT_API_KEY/BYBIT_API_SECRET and BYBIT_TESTNET_API_KEY/BYBIT_TESTNET_API_SECRET
# are Secret Manager bindings. Never put their values here or in scenario/fixture files.
